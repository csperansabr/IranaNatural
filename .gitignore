sessions/
*.cache

#################################################
# DATABASE / DUMPS / BACKUPS
#################################################

*.sql
*.sql.gz
*.dump
*.bak

# Permite migrations e esquema versionados em sql/
!sql/
!sql/migration_*.sql
!sql/schema.sql
!sql/seed.sql
!sql/produtos.sql
!sql/setup_inicial.sql

# Bloqueia dumps completos (expõem IP de servidor, dados reais)
sql/SiteIrana_*.sql
sql/*_HostGator.sql
sql/*_Localhost.sql
sql/*_Backup.sql
sql/*_backup.sql

# Relatórios de comparação de banco (expõem estrutura interna)
sql/*.html
database/

