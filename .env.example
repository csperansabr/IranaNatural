# ─────────────────────────────────────────────────────────────────────────────
# Iraná Natural — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in the values below
# 3. Set permissions:         chmod 640 .env
# 4. NEVER commit .env to git (it is listed in .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# ── InfinitePay ───────────────────────────────────────────────────────────────
# Your InfiniteTag handle (without the "$" prefix)
INFINITEPAY_HANDLE=irananatural

# Webhook secret — generate with:  php tools/gerar-webhook-secret.php
# Then register the full webhook URL in your InfinitePay dashboard:
#   https://seu-dominio.com.br/webhook/infinitepay/<secret-here>
INFINITEPAY_WEBHOOK_SECRET=change-me-run-php-tools-gerar-webhook-secret
